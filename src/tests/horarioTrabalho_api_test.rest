@BASE = http://localhost:3000

### Listar todos os horarios de trabalho
GET {{BASE}}/horarios
Accept: application/json

### Criar um novo horario de trabalho
POST {{BASE}}/horarios
Content-Type: application/json

{
    "profissional_id": 1,
    "dia_semana": 1,
    "inicio": "09:00",
    "fim": "17:00"
}

### Atualizar um horario de trabalho existente
PUT {{BASE}}/horarios/1
Content-Type: application/json

{
    "profissional_id": 1,
    "dia_semana": 2,
    "inicio": "10:00",
    "fim": "18:00"
}

### Atualizar um horario de trabalho inexistente
PUT {{BASE}}/horarios/999
Content-Type: application/json

{
    "profissional_id": 1,
    "dia_semana": 3,
    "inicio": "09:00",
    "fim": "17:00"
}

### Deletar um horario de trabalho
DELETE {{BASE}}/horarios/1
Accept: application/json

### Deletar um horario de trabalho inexistente
DELETE {{BASE}}/horarios/999
Accept: application/json    